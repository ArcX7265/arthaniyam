# Safe default: creates deterministic local orders without network calls.
RAZORPAY_MODE=simulate

# To use Razorpay Test Mode, set RAZORPAY_MODE=test and add test-only keys.
# Live keys are rejected by the application.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_with_a_separate_webhook_secret

# Policy compiler. Reference mode is deterministic and works offline.
# For strict structured extraction through the OpenAI Responses API, use openai.
POLICY_COMPILER_MODE=reference
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5-mini

# Optional. Defaults to backend/arthaniyam.sqlite3.
# ARTHANIYAM_DATABASE_PATH=C:/path/to/arthaniyam.sqlite3
